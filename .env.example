# Create an application at https://devportal.jamendo.com/ to receive a read-only client ID.
# Jamendo's free API plan is for non-commercial apps. Configure this in Vercel too.
VITE_JAMENDO_CLIENT_ID=0eb15f21

# Enable YouTube video search. Configure this as a referrer-restricted API key in Vercel.
VITE_YOUTUBE_API_KEY=
